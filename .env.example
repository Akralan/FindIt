# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ces valeurs sont des valeurs par défaut : elles peuvent aussi être
# changées depuis l'application (page Réglages), sans redémarrage.

# Provider IA actif : "openai" | "local" | "mock"
# "local" tourne entièrement sur cette machine (llama.cpp + petit modèle
# instruct + OCR local pour les scans), aucune clé requise — le modèle se
# télécharge depuis la page Réglages au premier usage.
# "mock" ne fait aucun appel réseau et n'est pas proposé dans les Réglages —
# utile pour développer/tester sans rien télécharger ni configurer.
AI_PROVIDER=openai

# Clé API du provider actif (uniquement pour "openai").
OPENAI_API_KEY=

# Modèle utilisé (laisser vide pour garder la valeur par défaut du provider).
OPENAI_MODEL=gpt-4o-mini

# Dossier de stockage des fichiers et de la base (chemin relatif au projet).
DATA_DIR=./data
